# Copy to .env for local/runtime development only. Do not commit .env.

# AI / embeddings
# OPENAI_API_KEY=

# Supabase project runtime secrets
# PHE_SUPABASE_URL=
# PHE_SUPABASE_SERVICE_ROLE_KEY=

# Google Drive media/archive storage
# PHE_GOOGLE_DRIVE_FOLDER_ID=
# PHE_GOOGLE_SERVICE_ACCOUNT_JSON=/absolute/path/to/service-account.json

# Discord team-facing PHE bot / output channels
# PHE_DISCORD_BOT_TOKEN=
# PHE_DISCORD_GUILD_ID=
# PHE_DISCORD_OUTPUT_CHANNEL_ID=
# PHE_DISCORD_REVIEW_CHANNEL_ID=

# Internal endpoint/bot boundary
# PHE_INTERNAL_ENDPOINT_SECRET=
